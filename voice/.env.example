# Copy to voice/.env. HUB_KEY must match HUB_KEY in api/.env.
HUB_URL="http://127.0.0.1:4101/api"
HUB_KEY="paste-the-HUB_KEY-from-api/.env"
# This service listens here; the hub calls POST /speak on it.
PORT=4103
# ElevenLabs (online speech-to-text + voice). Empty = local fallbacks only (whisper, Kokoro, pyttsx3).
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
# Speech-to-text: true = ElevenLabs Scribe first, local Whisper when offline. false = local only (recordings never leave the hub).
ELEVENLABS_STT=true
# Speaker match score needed to count as a known person (lower = guest).
ID_THRESHOLD=0.5
