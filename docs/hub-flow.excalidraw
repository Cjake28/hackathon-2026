    {"type":"text","id":"ev_text","x":1258,"y":714,"width":610,"height":98,"text":"// what Ana's phone gets: GET /api/device/poll?after=41\n{ \"cursor\": 43,\n  \"notices\": [{ \"kind\": \"alarm:ring\", \"text\": \"Wake up\",\n                \"data\": { \"alarmId\": 12 } }],\n  \"ringing\": [{ \"id\": 12, \"label\": \"Wake up\", \"repeat\": \"once\" }],\n  \"home\":    [{ \"name\": \"Ana\", \"isHome\": true }] }","originalText":"// what Ana's phone gets: GET /api/device/poll?after=41\n{ \"cursor\": 43,\n  \"notices\": [{ \"kind\": \"alarm:ring\", \"text\": \"Wake up\",\n                \"data\": { \"alarmId\": 12 } }],\n  \"ringing\": [{ \"id\": 12, \"label\": \"Wake up\", \"repeat\": \"once\" }],\n  \"home\":    [{ \"name\": \"Ana\", \"isHome\": true }] }","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400043,"version":1,"versionNonce":400044,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

