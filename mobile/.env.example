# Empty = use the computer running `expo start` (port 4101). Set it for a deployed API, e.g. https://api.example.com/api
EXPO_PUBLIC_API_URL=""

# Google sign-in (development build only, not Expo Go). Web client ID = GOOGLE_CLIENT_ID in api/.env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""

# Local Expo MCP: lets the AI take screenshots, tap and read logs on an Android emulator / iOS simulator.
# Needs `npx expo login` (same Expo account as the MCP). Harmless when not logged in.
EXPO_UNSTABLE_MCP_SERVER=1
