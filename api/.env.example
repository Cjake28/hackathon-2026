DATABASE_URL="postgresql://postgres:postgres@localhost:4102/hackathon"
PORT=4101
# `npm run setup` replaces this with a random secret.
JWT_SECRET="change-me-to-a-long-random-string"

# New accounts with these emails (comma-separated) get the admin role automatically.
ADMIN_EMAILS=""

# Local AI (Ollama on the hub). Download the models once: `ollama pull <model>`.
OLLAMA_HOST="http://127.0.0.1:11434"
# Chat model. No GPU / small laptop: qwen3.5:2b. GPU with 4-6 GB VRAM: qwen3.5:4b. 8 GB+ VRAM: qwen3.5:9b.
AI_MODEL="qwen3.5:2b"
# RAG embeddings (multilingual, 768 numbers per text; the database expects 768).
AI_EMBEDDING_MODEL="embeddinggemma"
# Step-by-step reasoning: smarter answers but much slower on small machines.
AI_THINK="false"
# How much text the model sees at once (tokens). More = more memory.
AI_CONTEXT=8192
# Keep the model loaded between questions so answers start fast.
AI_KEEP_ALIVE="30m"
# How many questions the AI answers at the same time (used when the hub / npm run ai starts Ollama).
# CPU only: 1. GPU: 2-4 (each one needs extra memory).
AI_PARALLEL=1

# Only when the API sits behind a reverse proxy (so rate limits see the real client IP).
TRUST_PROXY="false"
# Comma-separated browser origins allowed to call the API in production (rarely needed: the hub serves the web app).
CORS_ORIGINS=""
