generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  avatarUrl String?
  roleId        Int
  role          Role           @relation(fields: [roleId], references: [id])
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  lastSeenAt    DateTime? // presence: updated by GET /api/device/poll
  lastIp        String?
  alarms        Alarm[]
  tasks         Task[]
  memories      MemoryNote[]
}

// AI chat history, saved per user.
model Conversation {
  id        Int                   @id @default(autoincrement())
  userId    Int
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String                @default("New chat")
  useDocs   Boolean               @default(false) // answer from the RAG documents
  useTools  Boolean               @default(false) // let the AI use app tools (api/src/ai/tools.ts)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  messages  ConversationMessage[]
}

model ConversationMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  image          String? // base64 JPEG the user attached
  sources        Json? // RAG sources the answer used
  action         Json? // a tool action waiting for the user's OK: { tool, args, description, status }
  createdAt      DateTime     @default(now())
}

// Permission-based RBAC: a role is a named list of permissions. "*" means every permission.
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  permissions String[]
  users       User[]
}

// RAG: an uploaded file, split into chunks that each carry an embedding (pgvector).
// Chunks are written and searched with raw SQL in api/src/rag/rag.service.ts.
model Document {
  id        Int             @id @default(autoincrement())
  title     String
  source    String          @unique // file name; uploading the same name replaces the document
  createdAt DateTime        @default(now())
  chunks    DocumentChunk[]
}

model DocumentChunk {
  id         Int                         @id @default(autoincrement())
  documentId Int
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int
  page       Int?
  content    String
  embedding  Unsupported("vector(768)") // keep in sync with EMBEDDING_DIMENSIONS in ai.service.ts
}

// App settings changed from the UI (e.g. "ai.model", picked on the web AI Settings page).
model Setting {
  key   String @id
  value String
}

// The family grocery list (#58). The boilerplate's to-do example, reused.
model Item {
  id        Int      @id @default(autoincrement())
  name      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---- Family hub (contract: TEAM-PLAN.md section 4.1) ----

// #25 #28 #29: alarms AND reminders (a reminder is an alarm with kind "reminder")
model Alarm {
  id          Int       @id @default(autoincrement())
  userId      Int // who it rings for
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdById Int // a parent, or the user themself
  kind        String    @default("alarm") // "alarm" | "reminder"
  label       String    @default("Alarm") // "Wake up", "Take medicine", "Leave for school"
  time        String // "06:30", 24h, hub local time
  repeat      String    @default("once") // "once" | "daily" | "weekdays"
  nextAt      DateTime // next ring; the scheduler moves it forward
  enabled     Boolean   @default(true)
  ringingAt   DateTime? // set while ringing, cleared on dismiss/snooze
  createdAt   DateTime  @default(now())
}

// #12 #13: tasks from a parent; chores are checked by photo
model Task {
  id          Int       @id @default(autoincrement())
  title       String
  assigneeId  Int
  assignee    User      @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById Int
  isChore     Boolean   @default(false) // chores need before/after photos
  checklist   String[] // what "done" looks like: ["sink is empty", "dishes are in the rack"]
  dueAt       DateTime?
  status      String    @default("pending") // "pending" | "redo" | "done"
  beforePhoto String? // base64 JPEG
  afterPhoto  String?
  feedback    String? // the AI's specific feedback
  createdAt   DateTime  @default(now())
  doneAt      DateTime?
}

// #9: what Jarvis remembers about each person (stays on the hub)
model MemoryNote {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String // "likes adobo", "allergic to shrimp", "piano every Saturday"
  createdAt DateTime @default(now())
}

// "Push" without WebSockets: devices poll GET /api/device/poll every 3 s and receive new rows.
model Notice {
  id        Int      @id @default(autoincrement())
  toUserId  Int? // null = every device
  kind      String // NoticeKind in api/src/family.ts
  text      String // what to show
  data      Json? // e.g. { "taskId": 7 } or { "alarmId": 3 }
  createdAt DateTime @default(now())
}

// #58 calendar
model Event {
  id          Int      @id @default(autoincrement())
  title       String
  startsAt    DateTime
  userId      Int? // null = whole family
  createdById Int
  createdAt   DateTime @default(now())
}

// #58 budget (monthly limit lives in Setting key "budget.monthly")
model Expense {
  id        Int      @id @default(autoincrement())
  amount    Float // pesos
  category  String   @default("other") // "food" | "bills" | "school" | "transport" | "other"
  note      String   @default("")
  addedById Int
  spentAt   DateTime @default(now())
}
