DATABASE_URL="postgresql://postgres:postgres@localhost:4102/hackathon"
PORT=4101
JWT_SECRET="change-me-to-a-long-random-string"

# Google sign-in: OAuth Client ID (Web). Same value as VITE_GOOGLE_CLIENT_ID (web) and EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (mobile).
GOOGLE_CLIENT_ID=""
# Only for the mobile app on iOS: the iOS OAuth client ID.
GOOGLE_IOS_CLIENT_ID=""

# Email (OTP codes). Default = Mailpit from docker compose; open http://localhost:4104 to read the emails.
# Real SMTP: set your provider's host/port/user/pass. Empty SMTP_HOST = emails are printed in the API console.
SMTP_HOST="localhost"
SMTP_PORT=4103
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Hackathon <no-reply@hackathon.local>"

# Production only: comma-separated origins allowed to call the API from a browser on another domain,
# e.g. "https://myapp.com". The web app behind the same domain and the mobile app do not need it.
CORS_ORIGINS=""

# New accounts with these emails (comma-separated) get the admin role automatically.
ADMIN_EMAILS=""

# AI (Gemini). Free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Text model: gemini-3.8-flash (recommended) or gemini-3.5-flash-lite (cheapest, fastest).
AI_MODEL="gemini-3.8-flash"
AI_EMBEDDING_MODEL="gemini-embedding-001"
# Vertex AI instead of an API key (uses your Google Cloud credits): set these three and leave GEMINI_API_KEY empty.
# Credentials: run `gcloud auth application-default login`, or set GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"

# Backup AI: used automatically, in this order, when the one before fails (rate limit, error, outage).
# 1) Another Gemini key, e.g. from a second Google account (separate free quota). Also backs up RAG embeddings.
#    AI_MODEL_BACKUP alone (no backup key) = same key, another model (Gemini rate limits are per model).
GEMINI_API_KEY_BACKUP=""
AI_MODEL_BACKUP=""
# 2) Any OpenAI-compatible API: OpenAI, Groq, OpenRouter, ... Chat/text/JSON only (RAG embeddings stay on Gemini).
#    BACKUP_AI_BASE_URL empty = OpenAI. Groq: https://api.groq.com/openai/v1  OpenRouter: https://openrouter.ai/api/v1
#    BACKUP_AI_MODEL = a model id from that provider's docs.
BACKUP_AI_API_KEY=""
BACKUP_AI_BASE_URL=""
BACKUP_AI_MODEL=""
